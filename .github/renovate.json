{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices"],
    "automerge": true,
    "platformAutomerge": true,
    "customManagers": [
        {
            "description": "Tools the workflows download, pinned by a version and the SHA-256 or SHA-512 of the release attachment",
            "customType": "regex",
            "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+_VERSION: (?<currentValue>\\S+)\\s+[A-Z_]+_SHA(?:256|512): (?<currentDigest>[0-9a-f]{64}|[0-9a-f]{128})"
            ]
        }
    ],
    "packageRules": [
        {
            "matchUpdateTypes": ["major"],
            "automerge": false
        }
    ]
}
