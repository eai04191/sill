{
  "sourceLanguage" : "en",
  "strings" : {
    "?%@?" : {
      "shouldTranslate" : false
    },
    "· resets %@" : {
      "comment" : "When a rate limit window resets, e.g. \"· resets Oct 18, 9:00\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@にリセット"
          }
        }
      }
    },
    "%@\n\nPlease double check %@ and try again." : {
      "comment" : "The error, then what to do about it, with the path of the config file.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n%2$@を確認してから、もう一度お試しください。"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "VoiceOver value of the playback position: the elapsed time of the song's duration.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ resets in %@" : {
      "comment" : "VoiceOver: a rate limit window's usage and the time until it resets, e.g. \"16% resets in 1h\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、リセットまで%2$@"
          }
        }
      }
    },
    "%@ · lasts until reset" : {
      "comment" : "The pace of a rate limit window that lasts until it resets, e.g. \"72% in reserve · lasts until reset\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · リセットまで持つ"
          }
        }
      }
    },
    "%@ · runs out in %@" : {
      "comment" : "The pace of a rate limit window that runs out before it resets, e.g. \"3% in deficit · runs out in 4d 15h\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · あと%2$@で上限"
          }
        }
      }
    },
    "%@%% in deficit" : {
      "comment" : "Usage above an even pace, e.g. \"3% in deficit\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%%の超過"
          }
        }
      }
    },
    "%@%% in reserve" : {
      "comment" : "Usage below an even pace, e.g. \"72% in reserve\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%%の余裕"
          }
        }
      }
    },
    "%@, %@, workspace %@" : {
      "comment" : "VoiceOver label of a window in the window switcher: the window title, app and workspace.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@、ワークスペース%3$@"
          }
        }
      }
    },
    "%@, muted" : {
      "comment" : "VoiceOver value of the volume widget while muted.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、消音"
          }
        }
      }
    },
    "%lld" : {
      "shouldTranslate" : false
    },
    "%lld available" : {
      "comment" : "How many free rate limit resets can be used, e.g. \"3 available\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残り%lld回"
