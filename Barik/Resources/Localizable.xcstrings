{
  "sourceLanguage" : "en",
  "strings" : {
    "?%@?" : {
      "shouldTranslate" : false
    },
    "· resets in %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· リセットまで%@"
          }
        }
      }
    },
    "%@\n\nPlease double check ~/.barik-config.toml and try again." : {
      "comment" : "The error, then what to do about it.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n~/.barik-config.tomlを確認してから、もう一度お試しください。"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "VoiceOver value of the playback position: the elapsed time of the song's duration.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ resets in %@" : {
      "comment" : "VoiceOver: a rate limit window's usage and the time until it resets, e.g. \"16% resets in 1h\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、リセットまで%2$@"
          }
        }
      }
    },
    "%@, muted" : {
      "comment" : "VoiceOver value of the volume widget while muted.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、消音"
          }
        }
      }
    },
    "%lld" : {
      "shouldTranslate" : false
    },
